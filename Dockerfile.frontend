# ==============================================================================
# Cheat Clip PRO — Frontend image (React + Vite production build served by nginx)
# Multi-arch: builds natively on linux/amd64 and linux/arm64.
# ==============================================================================

# ── Stage 1: Build the React/Vite bundle ──────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: Serve with nginx + reverse-proxy /api and /mcp ───────────────────
FROM nginx:1.27-alpine AS runner

# Runtime DNS resolver + MCP upstream for the /mcp location. Docker/Coolify uses
# 127.0.0.11; override CCP_MCP_RESOLVER for other runtimes (e.g. Podman).
ENV CCP_MCP_RESOLVER=127.0.0.11 \
    CCP_MCP_UPSTREAM=http://mcp:8765

# Custom server config as a template; the nginx entrypoint envsubst's it.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template

# Static build output.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
