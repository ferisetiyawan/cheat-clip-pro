{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cheat-clip-pro": {
      "type": "local",
      "command": ["uv", "run", "--directory", "mcp", "cheat-clip-mcp"],
      "enabled": true,
      "environment": {
