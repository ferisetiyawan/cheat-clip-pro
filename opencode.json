    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6LC44IgsjgYVj1LUF-5SUQzaV6OiSwVBvuT_C0qlTLouw"
      }
    }
  }
}
