# ==============================================================================
# Cheat Clip PRO — Frontend (static SPA + reverse proxy to backend + MCP)
# This is an nginx TEMPLATE: the official nginx image runs envsubst over it at
# startup, so ${CCP_MCP_RESOLVER} / ${CCP_MCP_UPSTREAM} are filled from env.
# ==============================================================================

# Preserve the original scheme through proxy chains (e.g. Coolify's TLS proxy)
# so the backend can mark the session cookie Secure on HTTPS.
map $http_x_forwarded_proto $ccp_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    # Runtime DNS resolver for the MCP upstream. Docker/Coolify = 127.0.0.11;
    # other runtimes (e.g. Podman) set CCP_MCP_RESOLVER to their DNS gateway.
    resolver ${CCP_MCP_RESOLVER} valid=10s ipv6=off;
    set $mcp_upstream ${CCP_MCP_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # Uploads (YouTube/Drive clones and user videos) can be very large.
    client_max_body_size 8g;
    client_body_timeout 3600s;

    # ── Coolify / Docker health probe ─────────────────────────────────────────
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ── API reverse proxy (same-origin for the SPA, so no CORS needed) ───────
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ccp_forwarded_proto;
        proxy_set_header Connection "";

        # Server-Sent Events (/api/analyze, /api/render-progress) must stream
        # unbuffered with a long timeout; rendering a batch can take many minutes.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }

    # ── FastAPI docs (optional, handy in staging) ────────────────────────────
    location ~ ^/(docs|redoc|openapi\.json) {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ccp_forwarded_proto;
    }

    # ── MCP server (Streamable HTTP) ─────────────────────────────────────────
    # Exposes the Model Context Protocol endpoint on the SAME HTTPS domain as the
    # app: https://<your-domain>/mcp  (no second domain needed in Coolify).
    # Auth is enforced by the MCP server itself (MCP_HTTP_TOKEN / MCP_API_KEY).
    location /mcp {
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ccp_forwarded_proto;
        proxy_set_header Connection "";
        # Streamable HTTP uses SSE for server->client messages: no buffering,
        # long timeouts.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }

    # ── Static assets: long-lived cache ──────────────────────────────────────
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── SPA fallback ─────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
